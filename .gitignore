# ============================================================
#  Python 程序设计实验 · 课程作品集  .gitignore
# ============================================================

# ---------- Python 字节码与缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# ---------- 打包 / 分发 ----------
build/
dist/
*.egg-info/
*.egg
.eggs/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/
.python-version

# ---------- 单元测试 / 覆盖率 ----------
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.cover

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/

# ---------- 类型检查 / 代码格式化缓存 ----------
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- 日志与临时文件 ----------
*.log
*.tmp
*.bak

# ---------- 数据与输出（大文件按需忽略）----------
data/
output/
*.csv
*.xlsx
!第*/数据说明.md

# ---------- 本地私密配置 ----------
.env
.env.*
secrets.*
